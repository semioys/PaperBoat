// Shared body of the PaperBoat CRT post passes (crt_subtle / crt_strong).
// Expects kScanStrength, kMaskStrength, kVignette and kCurvature to be defined.
//
// Cheap by design: one texture fetch and a handful of ALU ops per pixel.
// Scanlines use a whole number of output pixels per line (3 at 720p, 4 at
// 1080p), so they stay even instead of beating against the pixel grid.

vec2 crtCurve(vec2 uv) {
    vec2 centered = uv * 2.0 - 1.0;
    vec2 offset = abs(centered.yx) * kCurvature;
    centered += centered * offset * offset;
    return centered * 0.5 + 0.5;
}

void main() {
    vec2 uv = crtCurve(vTexCoord0);
    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) {
        @{vOutColor} = vec4(0.0, 0.0, 0.0, 1.0);
        return;
    }

    vec3 color = @{texture}(uTex0, uv).rgb;
    float height = float(textureSize(uTex0, 0).y);

    // Scanlines: about 240 visible lines, each an integer number of pixels tall.
    float pixelsPerLine = max(2.0, floor(height / 240.0 + 0.5));
    float linePos = fract(gl_FragCoord.y / pixelsPerLine);
    float beam = 0.5 + 0.5 * cos(6.2831853 * (linePos - 0.5));
    // Bright pixels bloom across the gap, like a real beam.
    float luma = dot(color, vec3(0.299, 0.587, 0.114));
    float scan = 1.0 - kScanStrength * (1.0 - beam) * (1.0 - 0.6 * luma);

    // Aperture mask: R/G/B stripes on consecutive screen columns.
    float column = mod(floor(gl_FragCoord.x), 3.0);
    vec3 mask = vec3(1.0 - kMaskStrength);
    if (column < 0.5) {
        mask.r = 1.0;
    } else if (column < 1.5) {
        mask.g = 1.0;
    } else {
        mask.b = 1.0;
    }

    // Vignette towards the corners.
    vec2 edge = uv * (1.0 - uv);
    float vignette = mix(1.0, clamp(pow(edge.x * edge.y * 16.0, 0.25), 0.0, 1.0), kVignette * 4.0);

    // Give back the average light the scanlines and mask take away.
    float compensate = 1.0 + kScanStrength * 0.45 + kMaskStrength * 0.6;
    color = color * scan * mask * vignette * compensate;
    @{vOutColor} = vec4(min(color, vec3(1.0)), 1.0);
}
